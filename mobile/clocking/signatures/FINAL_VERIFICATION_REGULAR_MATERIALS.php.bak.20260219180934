try {
    // Simulate the API call
    $query = "SELECT description, sub_description, SUM(quantity) as total_quantity, 
              GROUP_CONCAT(representative_full_name) as representatives,
              COUNT(*) as submission_count,
              MAX(created_at) as last_submission
              FROM material_forms 
              WHERE classID = ?
              GROUP BY description, sub_description
              ORDER BY description, sub_description";
    
    $stmt = $conn->prepare($query);
    $stmt->bind_param("i", $classID);
    $stmt->execute();
    $result = $stmt->get_result();
    $submissions = $result->fetch_all(MYSQLI_ASSOC);
    
    // Process submissions like the API does
    $checkboxStatus = [];
    $quantities = [];
    $representatives = [];
    $regularMaterials = [];
    
    foreach ($submissions as $submission) {
        $desc = $submission['description'];
        $subDesc = $submission['sub_description'];
        $totalQty = intval($submission['total_quantity']);
        $repNames = $submission['representatives'];
        
        if ($desc === 'Learning Material') {
            // Handle Unit Standards and Learner Guides
            preg_match('/(\d+)/', $subDesc, $matches);
            $unitStandardId = $matches[0] ?? 'unknown';
            
            $isLearnerGuide = (stripos($subDesc, 'learner guide') !== false);
            $checkboxKey = $isLearnerGuide ? $unitStandardId . '_LG' : $unitStandardId;
            
            $checkboxStatus[$checkboxKey] = ($totalQty > 0);
            $quantities[$checkboxKey] = $totalQty;
            $representatives[$checkboxKey] = $repNames;
        } else {
            // Handle regular materials
            $materialKey = $desc;
            $regularMaterials[$materialKey] = [
                'quantity' => $totalQty,
                'representative' => $repNames,
                'hasSubmissions' => ($totalQty > 0)
            ];
        }
    }
    
    echo "<div class='success'>";
    echo "<p><span class='status-ok'>✅ API Processing: SUCCESS</span></p>";
    echo "<p><strong>Total Submissions Found:</strong> " . count($submissions) . "</p>";
    echo "<p><strong>Unit Standards/Learner Guides:</strong> " . count($checkboxStatus) . " items</p>";
    echo "<p><strong>Regular Materials:</strong> " . count($regularMaterials) . " types</p>";
    echo "</div>";
    
    if (!empty($regularMaterials)) {
        echo "<h3>📦 Regular Materials Data:</h3>";
        echo "<table>";
        echo "<tr><th>Material Type</th><th>Total Quantity</th><th>Representatives</th><th>Status</th></tr>";
        
