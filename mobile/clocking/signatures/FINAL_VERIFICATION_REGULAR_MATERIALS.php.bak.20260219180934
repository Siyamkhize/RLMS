            echo "<td><strong>$materialType</strong></td>";
            echo "<td class='highlight'>{$data['quantity']}</td>";
            echo "<td>{$data['representative']}</td>";
            echo "<td>$status</td>";
            echo "</tr>";
        }
        echo "</table>";
    } else {
        echo "<div class='warning'>";
        echo "<p>⚠️ No regular materials found. This is normal if no PPE/ToolKit/Consumables have been submitted yet.</p>";
        echo "</div>";
