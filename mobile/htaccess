DirectoryIndex login.php

Options -Indexes

# Prevent access to sensitive application/config/log files
<FilesMatch "(^\.|\.env|connection\.php|database\.sql|\.sql$|\.bak$|\.backup$|\.old$|\.orig$|\.log$|composer\.(json|lock))">
    Require all denied
</FilesMatch>

# Block direct browser access to uploaded documents/media.
# Files must be served through serve_file.php after application authorization.
<FilesMatch "\.(pdf|jpg|jpeg|png|doc|docx|xls|xlsx|zip)$">
    Require all denied
</FilesMatch>

# Explicitly allow the controlled file-serving endpoint
<Files "serve_file.php">
    Require all granted
</Files>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
