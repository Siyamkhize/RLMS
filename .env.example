# Database Configuration
DB_HOST=localhost
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_password
DB_NAME=rlmss

# Encryption Keys (Generate with: openssl rand -base64 32)
AES_ENCRYPTION_KEY=GENERATE_32_BYTE_KEY_HERE
SESSION_ENCRYPTION_KEY=GENERATE_32_BYTE_KEY_HERE

# Security Settings
ENVIRONMENT=production
ENABLE_DEBUG=false
SESSION_TIMEOUT=1800

# API Configuration
API_RATE_LIMIT=100
API_RATE_WINDOW=60

# File Upload
MAX_UPLOAD_SIZE=209715200
UPLOAD_PATH=/var/secure_uploads/

# HTTPS Configuration
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
